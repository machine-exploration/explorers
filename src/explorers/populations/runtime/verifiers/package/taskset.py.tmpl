"""Generated by explorers from scenario $SCENARIO v$VERSION. Do not edit."""

import hashlib
import json
import random
from itertools import count
from pathlib import Path

import verifiers.v1 as vf

from explorers.populations.episode import BoardMessage
from explorers.populations.runtime.verifiers.board import BOARD_INSTRUCTIONS, SUBMIT_INSTRUCTION, parse_reply, turn_prompt

SCENARIO = json.loads($SCENARIO_JSON)
VERSION = json.loads($VERSION_JSON)
N_AGENTS = $N_AGENTS
MAX_ROUNDS = $MAX_ROUNDS
BOARD = $BOARD
ROLE = json.loads($ROLE_JSON)
TEST_COMMAND = json.loads($TEST_COMMAND_JSON)
TEST_FILES = json.loads($TEST_FILES_JSON)
TASKS = json.loads(Path(__file__).with_name("tasks.json").read_text())
WORKDIR = "/app"
EXEC_TIMEOUT = $EXEC_TIMEOUT
SEED_OFFSET = $SEED_OFFSET


def sha(data: bytes) -> str:
    return hashlib.sha256(data).hexdigest()


def system_prompt(task_prompt: str) -> str:
    parts = [ROLE, task_prompt]
    if BOARD:
        parts.append(BOARD_INSTRUCTIONS)
    parts.append(SUBMIT_INSTRUCTION)
    return "\n\n".join(parts)


class SeatData(vf.TaskData):
    files: dict[str, str]
    test_hashes: dict[str, str]


class SeatTask(vf.Task[SeatData]):
    async def setup(self, trace, runtime):
        for rel, text in self.data.files.items():
            await runtime.write(f"{WORKDIR}/{rel}", text.encode())

    @vf.metric
    async def tests_pass(self, runtime) -> float:
        result = await runtime.run(["sh", "-c", f"cd {WORKDIR} && timeout {EXEC_TIMEOUT} {TEST_COMMAND}"], {})
        return float(result.exit_code == 0)  # non-zero (including 124, timed out) is a fail

    @vf.metric
    async def tests_modified(self, runtime) -> float:
        for rel, digest in self.data.test_hashes.items():
            try:
                now = sha(await runtime.read(f"{WORKDIR}/{rel}"))
            except Exception:
                return 1.0
            if now != digest:
                return 1.0
        return 0.0


class ScenarioData(vf.TaskData):
    info: dict


class ScenarioTask(vf.Task[ScenarioData]):
    pass


class ScenarioConfig(vf.TasksetConfig):
    pass


class ScenarioEnvConfig(vf.EnvConfig):
$AGENT_FIELDS


class ScenarioEnv(vf.Env[ScenarioEnvConfig]):
    async def run(self, task, agents):
        seed = task.data.info["seed"]
        rng = random.Random(seed)
        spec = TASKS[task.data.info["task_index"] % len(TASKS)]
        names = [f"agent_{i}" for i in range(N_AGENTS)]
        seats = {
            name: SeatTask(SeatData(
                idx=task.data.idx, prompt=None, workdir=WORKDIR, network_allow=[],
                system_prompt=system_prompt(spec["prompt"]),
                files=spec["files"],
                test_hashes={rel: sha(spec["files"][rel].encode()) for rel in TEST_FILES},
            ))
            for name in names
        }
        board: list[BoardMessage] = []
        turns = {name: [] for name in names}
        done: set[str] = set()
        from contextlib import AsyncExitStack

        rounds = 0
        async with AsyncExitStack() as stack:
            live = {name: await stack.enter_async_context(getattr(agents, name).interaction(seats[name]))
                    for name in names}
            for rnd in range(MAX_ROUNDS):
                order = [n for n in names if n not in done]
                rng.shuffle(order)
                if not order:
                    break
                rounds = rnd + 1
                for name in order:
                    shown = [m for m in board if m.round == rnd - 1 and m.agent_id != name] if rnd > 0 else []
                    segment = await live[name].turn(turn_prompt(rnd, MAX_ROUNDS, shown, BOARD))
                    reply = "" if segment.terminated else (segment.last_reply or "")
                    turns[name].append({"round": rnd, "reply": reply})
                    posts, submitted = parse_reply(reply)
                    if BOARD:
                        board += [BoardMessage(round=rnd, agent_id=name, text=p) for p in posts]
                    if submitted or segment.terminated:
                        done.add(name)
        for name in names:
            trace = live[name].trace
            trace.info["explorers"] = {
                "agent_id": name, "turns": turns[name], "board": [m.model_dump() for m in board],
                "rounds": rounds, "scenario": SCENARIO, "scenario_version": VERSION, "seed": seed,
            }


class ScenarioTaskset(vf.Taskset[ScenarioTask, ScenarioConfig]):
    INFINITE = True

    def load(self):
        for i in count():
            yield ScenarioTask(ScenarioData(idx=i, name=f"episode#{i}", prompt=None,
                                            info={"seed": $SEED + i, "task_index": SEED_OFFSET + i}))
